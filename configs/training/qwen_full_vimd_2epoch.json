{
  "dataset": {
    "kind": "auto",
    "root": null,
    "handle": "thanhlamdev/vimd-dataset",
    "dataset_id": "vimd",
    "cache_dir": "outputs/cache",
    "allow_download": true
  },
  "model": {
    "key": "qwen_full_vimd_adalora",
    "backend": "qwen3_asr",
    "model_id": "Qwen/Qwen3-ASR-1.7B-hf",
    "dtype": "float16"
  },
  "decode": {"language": "Vietnamese", "max_new_tokens": 768, "do_sample": false, "num_beams": 1},
  "train": {
    "epochs": 2,
    "per_device_batch_size": 1,
    "gradient_accumulation_steps": 8,
    "learning_rate": 0.0001,
    "weight_decay": 0.01,
    "warmup_ratio": 0.03,
    "gradient_clip_norm": 1.0,
    "precision": "fp16",
    "num_workers": 2,
    "world_size": 2,
    "seed": 24127159,
    "adalora": {
      "init_r": 16,
      "target_r": 8,
      "alpha": 16,
      "dropout": 0.05,
      "target_modules": ["q_proj", "v_proj"],
      "tinit_ratio": 0.05,
      "tfinal_ratio": 0.05,
      "delta_t": 10
    }
  },
  "output_dir": "outputs/fine-tuning/vimd_qwen_adalora_full_2epoch",
  "run_id": "qwen_full_vimd_2epoch"
}
