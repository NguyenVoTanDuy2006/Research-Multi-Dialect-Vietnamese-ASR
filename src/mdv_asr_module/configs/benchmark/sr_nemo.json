{
  "dataset": {
    "kind": "auto",
    "root": null,
    "handle": "thanhlamdev/vimd-dataset",
    "dataset_id": "vimd",
    "cache_dir": "outputs/cache",
    "allow_download": true
  },
  "decode": {"language": "Vietnamese", "max_new_tokens": 768, "do_sample": false, "num_beams": 1},
  "benchmark": {
    "split": "test",
    "resume": true,
    "flush_every": 10,
    "models": [
      {"key": "canary_qwen", "backend": "nemo_salm", "model_id": "nvidia/canary-qwen-2.5b", "dtype": "float16"},
      {"key": "parakeet_tdt", "backend": "nemo_asr", "model_id": "nvidia/parakeet-tdt-0.6b-v2", "dtype": "float16"}
    ]
  },
  "output_dir": "outputs/benchmark_models/vimd_nemo_only",
  "run_id": "vimd_nemo_only"
}
