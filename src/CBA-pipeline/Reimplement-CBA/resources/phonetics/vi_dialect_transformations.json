{
  "schema_version": "1.0",
  "language": "vi",
  "name": "Quốc ngữ-to-dialect phonetic transformation vocabulary",
  "input_representation": "Syllables parsed with vi_phoneme_vocabulary.json",
  "output_representation": "A sequence of surface-phone tokens; preserve the underlying syllable and tone IDs alongside it.",
  "source": {
    "title": "Phonetic Modeling of Dialectal Variation in Vietnamese Speech",
    "file": "../../../../../docs/2605.24451v1.pdf",
    "sections": ["Appendix C.1", "Appendix C.2", "Appendix C.3", "Appendix F", "Figure 9"],
    "printed_pages": [15, 16, 17, 18, 19, 20],
    "notes": [
      "Rules below are transcribed from the article's dialect descriptions, not extracted from the authors' unreleased converter implementation.",
      "Where PDF IPA glyphs are malformed or an output depends on fine phonetic detail not encoded in the text, the rule records the articulatory operation and marks the surface transcription as requiring review.",
      "Province lists are the article's lists, not a current administrative lookup. Use ViMD's region metadata directly when available; do not infer a dialect for an unlisted or ambiguous label."
    ]
  },
  "application_order": [
    "parse Quốc ngữ syllable into onset, glide, nucleus, coda, tone",
    "apply the selected macro-dialect onset rules",
    "apply the selected macro-dialect rhyme rules",
    "apply the matching province/subdialect rules",
    "apply tone merger as an equivalence relation, not as a guessed one-way rewrite"
  ],
