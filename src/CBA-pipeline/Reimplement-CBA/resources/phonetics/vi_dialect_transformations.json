    {
      "id": "north_glide_distribution",
      "scope": "northern",
      "component": "rhyme_constraint",
      "conditions": [
        "The glide /u̯/ does not follow the back vowels /u, o, ɔ/.",
        "The offglide /i̯/ does not follow front vowels /i, e, ɛ/, except when the coda is velar."
      ],
      "operation": "constraint_only",
      "source_page": 15
    },
    {
      "id": "north_back_diphthong_centralization_before_u_glide",
      "scope": "northern",
      "component": "rhyme",
      "input_ipa": ["uə + u̯", "ɯə + u̯"],
      "output_description": "The back diphthong is realized as a central diphthong; the paper gives central targets [ɨ] and [ɨə].",
      "operation": "centralize_diphthong_before_rounded_glide",
      "orthographic_examples": [["con hươu", "con hiêu"], ["ly rượu", "ly riệu"], ["cấp cứu", "cấp kíu"], ["âm mưu", "âm miu"]],
      "source_page": 15,
      "surface_ipa_status": "approximate_source_transcription"
    },
    {
      "id": "north_front_vowel_velar_coda_changes",
      "scope": "northern",
      "component": "rhyme",
      "conditions": "Front vowel /i, e, ɛ/ followed by velar coda /ŋ/ or /k/.",
      "rules": [
        {"input_ipa": "iŋ", "output_ipa": "ɨjɲ"},
        {"input_ipa": "eŋ", "output_ipa": "əjɲ"},
        {"input_ipa": "ɛŋ", "output_ipa": "ɜjɲ"},
        {"input_ipa": "ik", "output_ipa": "ɨjc"},
        {"input_ipa": "ek", "output_ipa": "əjc"},
        {"input_ipa": "ɛk", "output_ipa": "ɜjc"}
