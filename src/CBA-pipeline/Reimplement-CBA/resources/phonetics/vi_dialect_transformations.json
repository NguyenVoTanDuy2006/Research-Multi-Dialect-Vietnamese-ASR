      "operation": "centralize_front_vowel_insert_j_glide_and_palatalize_velar_coda",
      "orthography_examples": ["inh", "ênh", "anh", "ich", "êch", "ach"],
      "source_page": 15,
      "surface_ipa_status": "normalized_from_printed_allophones; verify before using as a strict acoustic target"
    },
    {
      "id": "north_rounded_back_vowel_velar_coda_labialization",
      "scope": "northern",
      "component": "rhyme",
      "conditions": "Rounded back vowel /u, o, ɔ/ followed by velar coda /ŋ/ or /k/.",
      "operation": "shorten_or_centralize_the_vowel_and_labialize_the_velar_coda",
      "output_features": ["vowel loses/reduces its initial labial rounding", "velar coda is labialized"],
      "input_ipa_patterns": ["uŋ", "oŋ", "ɔŋ", "uk", "ok", "ɔk"],
      "output_ipa": null,
      "surface_ipa_status": "not normalized: exact superscript/diacritic sequence is not robustly recoverable from the PDF glyphs",
